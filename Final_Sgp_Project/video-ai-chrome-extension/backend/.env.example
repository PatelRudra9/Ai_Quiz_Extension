# Video AI Backend - Environment Variables
# Copy this to .env and fill in your values

# === AI Provider (Groq is primary, Ollama is fallback) ===
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile    # optional, defaults to llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434 # optional, defaults to localhost
# OLLAMA_MODEL=llama3.2                 # optional, defaults to llama3.2

# === Legacy (not used anymore, kept for reference) ===
# GEMINI_API_KEY=your_gemini_api_key_here

# === Database ===
MONGO_URI=mongodb://127.0.0.1:27017/video_ai_extension

# === Server ===
PORT=5000
NODE_ENV=development

# === Auth ===
JWT_SECRET=change_this_to_a_random_secret
